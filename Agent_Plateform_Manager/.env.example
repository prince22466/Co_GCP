# Required
PROJECT_ID=your-gcp-project-id

# Region / zone (Warsaw by default)
REGION=europe-central2
ZONE=europe-central2-a
NETWORK=default

# Artifact Registry
AR_REPO=arm-stage1
APP_IMAGE_NAME=arm-web
AGENT_IMAGE_NAME=arm-controller

# GKE
GKE_CLUSTER=arm-stage1-autopilot
GKE_NAMESPACE=arm-stage1
GKE_DEPLOYMENT=arm-web
GKE_SERVICE=arm-web
GKE_INGRESS=arm-web

# MIG / agent
MIG_NAME=arm-web-mig
MIG_TEMPLATE=arm-web-template-v1
MIG_MACHINE_TYPE=e2-highcpu-2
MIG_MIN=1
MIG_MAX=4
CONTROLLER_VM=arm-controller
CONTROLLER_MACHINE_TYPE=e2-micro

# Shared resource unit: 2 vCPU + ~2 GiB
UNIT_VCPU=2
UNIT_GIB=2
MAX_UNITS=4

# Stage-1 controller policy
SCALE_UP_CPU=0.65
SCALE_DOWN_CPU=0.30
DECISION_INTERVAL=60
COOLDOWN_SECONDS=120
CPU_LOOKBACK_SECONDS=300

# Workload
TRACE=scenarios/daily_24m.csv
WORK_CPU_MS=8
WARMUP_SECONDS=90
