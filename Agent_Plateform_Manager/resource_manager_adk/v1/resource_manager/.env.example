GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-real-project-id
GOOGLE_CLOUD_LOCATION=global
ADK_MODEL=gemini-3.6-flash

# Live GCP tool configuration. Keep local development in dry-run mode.
PROJECT_ID=your-real-project-id
REGION=europe-central2
MIG_NAME=arm-web-mig
STATE_BUCKET=your-project-id-arm-adk-state
MIG_MIN=1
MIG_MAX=4
SCALE_UP_CPU=0.65
SCALE_DOWN_CPU=0.30
CPU_LOOKBACK_SECONDS=300
COOLDOWN_SECONDS=120
SCALING_ENABLED=false
